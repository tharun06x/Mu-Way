# ── Django ────────────────────────────────────────────────────────────────────
# Generate a fresh secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Set to 'True' for local dev only. Must be 'False' in production.
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames. In production, set to your actual domain(s).
# e.g. ALLOWED_HOSTS=myapp.com,www.myapp.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production, set to your deployed frontend URL only.
# e.g. CORS_ALLOWED_ORIGINS=https://myapp.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── App Environment ───────────────────────────────────────────────────────────
# Set to 'production' in your deployment environment.
# When APP_ENV=production, missing DJANGO_SECRET_KEY raises an error at startup.
APP_ENV=development

# ── Supabase PostgreSQL (Database) ────────────────────────────────────────────
# Find this in: Supabase Dashboard → Settings → Database → Connection String → URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Supabase Storage (Model Artifacts) ───────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
# Use the "service_role" key (not the anon key) — this bypasses RLS for server use
SUPABASE_SERVICE_KEY=your-service-role-key-here
# Name of the storage bucket where model .pkl files are stored
SUPABASE_BUCKET=icrs-models
